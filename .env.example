# Wabbit local environment
# Copy this file to .env.local for Next.js development.

# Server-only Vercel AI Gateway credential.
# Do not expose this as a NEXT_PUBLIC_* variable.
AI_GATEWAY_API_KEY=

# Keep true for deterministic local QA without provider network calls.
WABBIT_USE_MOCK_AI=true

# Optional compatibility settings for legacy client-only mock paths.
NEXT_PUBLIC_WABBIT_USE_MOCK_API=true
NEXT_PUBLIC_WABBIT_MOCK_DELAY_MS=0
